/bin/bash -lc "sed -n '1,220p' drafts/reviews/02-codex.md 2>/dev/null || true; sed -n '1,160p' drafts/reviews/08-codex.md 2>/dev/null || true; ls drafts/reviews | sort | tail -30" in /home/diablo/book15
