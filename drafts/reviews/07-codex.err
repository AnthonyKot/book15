#!/usr/bin/env python3
"""Search the Summa corpus and print page + section for every hit.

    scripts/find.py "intelligence amplifier"
    scripts/find.py -p 107            # dump printed page 107
    scripts/find.py -s "The Black Box" # dump one section

Use this to write checks/quotes.tsv rows: the page it prints is the page the
row must cite. Matching is whitespace- and quote-mark-insensitive, like verify.sh.
"""
import re, sys
from corpus import load, norm

pages, sections = load()

def page_section(n):
    cur = "?"
    for start, title in sections:
        if start <= n: cur = title
        else: break
    return cur

if len(sys.argv) < 2:
    print(__doc__); sys.exit(0)
if sys.argv[1] == "-p":
    n = int(sys.argv[2]); print("== p.%d [%s]" % (n, page_section(n))); print(pages[n]); sys.exit(0)
if sys.argv[1] == "-s":
    want = sys.argv[2].lower()
    for i, (start, title) in enumerate(sections):
        if title.lower() == want:
            end = sections[i + 1][0] if i + 1 < len(sections) else len(pages)
            for n in range(start, end):
                print("== p.%d" % n); print(pages[n])
            sys.exit(0)
    print("no section named", sys.argv[2]); sys.exit(1)

needle = norm(" ".join(sys.argv[1:]))
hits = 0
for n, text in pages.items():
    flat = norm(text)
    i = flat.find(needle)
    while i >= 0:
        hits += 1
        ctx = flat[max(0, i - 80): i + len(needle) + 80]
        print("p.%-4d [%s]\n    …%s…" % (n, page_section(n), ctx))
        i = flat.find(needle, i + 1)
print("%d hit(s)" % hits)
You are reviewing one essay from a book that grades Stanisław Lem's *Summa Technologiae*
(1964; 2013 English tr.) from 2026, chapter by chapter. Read CONTEXT.md §4–5 and AGENT.md
in the repo first. Then read the essay HTML you were given.

Report findings only — no praise, no summary. For each finding: location (quote a
phrase), the problem, and what would fix it. Rank by severity.

Check, in this order:
1. **Misreading Lem.** Does the essay quote or paraphrase Lem accurately? Use
   scripts/find.py "<phrase>" to check any quote or page you doubt against the corpus.
   Is context omitted that changes the meaning? Is 1964-Lem graded for something
   1974-Lem already conceded?
2. **Verdict inflation.** Is any HIT really EARLY, RIGHT-ANSWER-WRONG-REASON, or a vague
   idea being credited with a specific outcome? Is any MISS unfair (he hedged)?
3. **2026 claims.** Is every factual claim about the present marked <!-- CHECK -->, and
   is any of them wrong or overstated to your knowledge? Name the ones you'd challenge.
4. **Missing MISS.** If the essay finds Lem right on everything, find what he got wrong
   in that chapter that the essay skipped.
5. **The two layers.** Are object-level and problem-level verdicts mixed in one row?
6. **Reader.** Would a skeptic of the "Lem predicted everything" claim be persuaded by
   the ledger, or by rhetoric?

exec
/bin/bash -lc "awk -F '\\t' 'NR<=3 || "'$1==7 || ($1==4 && ($2=="baseline-1964" || $2=="scaling-laws-2020" || $2=="gpt3-2020"))'"' checks/claims-2026.tsv && rg -n '"'^7'"\\t' checks/quotes.tsv && python3 scripts/find.py -p 239 && python3 scripts/find.py -p 241 && python3 scripts/find.py -p 259 && python3 scripts/find.py -p 260 && python3 scripts/find.py -p 261 && python3 scripts/find.py -p 263 && python3 scripts/find.py -p 264 && python3 scripts/find.py -p 265 && python3 scripts/find.py -p 266" in /home/diablo/book15
