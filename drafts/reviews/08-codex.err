from html.parser import HTMLParser
class P(HTMLParser):
 def __init__(self): super().__init__(); self.stack=[]; self.buf={'lede':[],'said':[],'happened':[]}
 def handle_starttag(self,tag,attrs):
  a=dict(attrs); keys=[]
  if tag=='p' and a.get('class')=='lede': keys.append('lede')
  if tag=='section' and a.get('class') in ('said','happened'): keys.append(a['class'])
  self.stack.append(keys)
 def handle_endtag(self,tag):
  if self.stack: self.stack.pop()
 def handle_data(self,d):
  active={k for frame in self.stack for k in frame}
  for k in active:self.buf[k].append(d)
p=P();p.feed(open('chapters/08-the-invisible-path.html').read())
for k,v in p.buf.items(): print(k,len(' '.join(v).split()))
PY" in /home/diablo/book15
