from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
 def __init__(self): super().__init__(); self.stack=[]; self.buf={}; self.active=[]
 def handle_starttag(self,tag,attrs):
  d=dict(attrs); self.stack.append(tag)
  cls=d.get('class','').split()
  for c in ('said','happened'):
   if c in cls: self.active.append((c,len(self.stack)))
 def handle_endtag(self,tag):
  if self.active and self.active[-1][1]==len(self.stack): self.active.pop()
  if self.stack: self.stack.pop()
 def handle_data(self,data):
  for c,_ in self.active:self.buf.setdefault(c,[]).append(data)
p=P();p.feed(Path('chapters/00-how-to-grade-a-prophet.html').read_text())
for k,v in p.buf.items():
 text=' '.join(v)
 print(k,len(text.split()))
